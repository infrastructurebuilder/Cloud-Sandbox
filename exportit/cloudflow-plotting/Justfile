# cloudflow-plotting: the plotting routines as their own distribution.

set shell := ["bash", "-euo", "pipefail", "-c"]

# List the targets.
default:
    @just --justfile {{ justfile() }} --list

# Create the environment and install the project with its development tools.
init:
    uv sync

# Build the source distribution and the wheel into dist/.
build:
    uv build

# New files get the full rule set; copied code must have no syntax errors and no undefined names.
lint:
    uv run ruff check tests
    uv run ruff format --check tests
    uv run ruff check --isolated --select E9,F63,F7,F82 src

# Type-check the new files; any error fails.
typecheck:
    uv run pyright

# Lint, type-check and the fast tests.
test: lint typecheck
    uv run pytest -q -m "not slow"

# Everything in test, then build the wheel and try it in an empty environment.
full-test: test
    uv run pytest -q -m slow

# Nothing is published from a copy inside Cloud-Sandbox.
release: full-test
    @echo "cloudflow-plotting: nothing to release from exportit/; see exportit/MAP.md"
