# sandbox-ops: the operator tools of a Cloud Sandbox, and the attic of what is retired.

set shell := ["bash", "-euo", "pipefail", "-c"]

# List the targets.
default:
    @just --justfile {{ justfile() }} --list

# Check that the tools the tests need are here (bash 4 or later, shellcheck).
init:
    @bash -c '((BASH_VERSINFO[0] >= 4))' || { echo "sandbox-ops: the tests need bash 4 or later on PATH" >&2; exit 1; }
    @command -v shellcheck >/dev/null || { echo "sandbox-ops: install shellcheck (brew install shellcheck; dnf install ShellCheck)" >&2; exit 1; }
    @echo "sandbox-ops: bash $(bash -c 'echo $BASH_VERSION'), shellcheck $(shellcheck --version | sed -n 's/^version: //p')"

# Nothing to compile: the tools are scripts, run by hand.
build:
    @echo "sandbox-ops: nothing to build"

# The test harnesses themselves have no shellcheck findings.
lint:
    shellcheck tests/check-scripts.sh tests/check-catalogue.sh

# The catalogue matches the files; every script parses or is recorded as not; shellcheck's findings are as recorded.
test: lint
    tests/check-catalogue.sh
    tests/check-scripts.sh

# There are no slower checks: no tool is run here.
full-test: test

# Write the shellcheck counts again, after reviewing a change in them.
record:
    tests/check-scripts.sh --record

# Nothing is published from a copy inside Cloud-Sandbox.
release: full-test
    @echo "sandbox-ops: nothing to release from exportit/; see exportit/MAP.md"
