# sandbox-terraform: the network, EFS volume, IAM role and head node of a sandbox.

set shell := ["bash", "-euo", "pipefail", "-c"]

# The tool that checks the module: OpenTofu, at the version the operator chose
# (the latest release on 2026-11-13). `just init` puts it in .tofu/, for this
# project only, and every target uses that copy.
export TOFU_VERSION := "1.13.9"
export TOFU_BIN := justfile_directory() / ".tofu" / TOFU_VERSION / "tofu"
export TF_IN_AUTOMATION := "1"
# Providers are downloaded once and kept here.
export TF_PLUGIN_CACHE_DIR := justfile_directory() / ".terraform-plugins"

# List the targets.
default:
    @just --justfile {{ justfile() }} --list

# Fetch OpenTofu, create the test environment, and initialise both modules without a backend (no AWS).
init:
    tools/install-tofu.sh "$TOFU_VERSION"
    uv sync
    mkdir -p "$TF_PLUGIN_CACHE_DIR"
    "$TOFU_BIN" init -backend=false -input=false -no-color
    "$TOFU_BIN" -chdir=remote-state init -backend=false -input=false -no-color

# Nothing to compile: the module is applied as it is.
build:
    @echo "sandbox-terraform: nothing to build"

# Lint and format-check the tests and the installer.
lint:
    shellcheck tools/install-tofu.sh
    uv run ruff check tests
    uv run ruff format --check tests

# Type-check the tests; any error fails.
typecheck:
    uv run pyright

# Lint, type-check; both modules validate, formatting and templates are as known. No AWS call.
test: lint typecheck
    uv run pytest -q -m "not slow"

# Everything in test, and the two fragments still fail as recorded (downloads providers).
full-test: test
    uv run pytest -q -m slow

# Nothing is published from a copy inside Cloud-Sandbox.
release: full-test
    @echo "sandbox-terraform: nothing to release from exportit/; see exportit/MAP.md"
