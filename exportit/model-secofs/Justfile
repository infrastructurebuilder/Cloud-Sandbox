# model-secofs: SECOFS (SCHISM): fetch, build, data.

set shell := ["bash", "-euo", "pipefail", "-c"]

# List the targets.
default:
    @just --justfile {{ justfile() }} --list

# Check that the tools the tests need are here (bash 4 or later, shellcheck).
init:
    @bash -c '((BASH_VERSINFO[0] >= 4))' || { echo "model-secofs: the tests need bash 4 or later on PATH" >&2; exit 1; }
    @command -v shellcheck >/dev/null || { echo "model-secofs: install shellcheck (brew install shellcheck; dnf install ShellCheck)" >&2; exit 1; }
    @echo "model-secofs: bash $(bash -c 'echo $BASH_VERSION'), shellcheck $(shellcheck --version | sed -n 's/^version: //p')"

# Nothing to compile here: the recipes build the model on a sandbox, by hand.
build:
    @echo "model-secofs: nothing to build"

# The test harness itself has no shellcheck findings.
lint:
    shellcheck tests/check-scripts.sh

# Every script parses (bash -n); shellcheck's findings are as recorded. Nothing is fetched or built.
test: lint
    tests/check-scripts.sh

# There are no slower checks: no model is built or run here.
full-test: test

# Write the shellcheck counts again, after reviewing a change in them.
record:
    tests/check-scripts.sh --record

# Nothing is published from a copy inside Cloud-Sandbox.
release: full-test
    @echo "model-secofs: nothing to release from exportit/; see exportit/MAP.md"
