# sandbox-configs: the job and cluster descriptions that cloudflow reads.

set shell := ["bash", "-euo", "pipefail", "-c"]

# List the targets.
default:
    @just --justfile {{ justfile() }} --list

# Create the test environment.
init:
    uv sync

# Nothing to compile: the descriptions are JSON, read as they are.
build:
    @echo "sandbox-configs: nothing to build"

# Lint and format-check the tests.
lint:
    uv run ruff check tests
    uv run ruff format --check tests

# Type-check the tests; any error fails.
typecheck:
    uv run pyright

# Lint, type-check; every file is as catalogued (kind, role, and whether cloudflow can read it).
test: lint typecheck
    uv run pytest -q

# There are no slower checks: nothing here reaches AWS.
full-test: test

# Write tests/catalogue.json again, after reviewing a change.
record:
    uv run python tests/descriptions.py --record

# Nothing is published from a copy inside Cloud-Sandbox.
release: full-test
    @echo "sandbox-configs: nothing to release from exportit/; see exportit/MAP.md"
